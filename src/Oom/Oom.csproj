<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oom</AssemblyName>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <!-- D1: .NET 10 LTS hedef; SDK kurulunca tek satir degisir -->
    <!-- No single-file, self-contained or trimmed publish. The installer that copied the running
         executable into the vault is gone, so the one thing those properties bought — an exe that
         survived being copied away from its runtime — is no longer needed. Plain `dotnet build`
         output is the deliverable. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the scar suite reach internal seams (the transcript parsers, Retrieve.CandidateSource)
         directly, without a second copy of the rule living in the test. -->
    <InternalsVisibleTo Include="Oom.Tests" />
  </ItemGroup>

</Project>
