<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oom</AssemblyName>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <!-- D1: .NET 10 LTS hedef; SDK kurulunca tek satir degisir -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Y-100: without this the SQLite native library stays beside the exe, and the installer,
         which copies the running file alone, produced a vault copy that died with
         DllNotFoundException on a clean Windows. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Y-116: lets the scar suite call Bench's internal exclusion counters directly, no copy of the rule. -->
    <InternalsVisibleTo Include="Oom.Tests" />
  </ItemGroup>

</Project>
